{
  "expo": {
    "name": "Munim Trader Native",
    "slug": "munim-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "munim",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.munim.trader"
    },
    "android": {
      "package": "ai.munim.trader",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-build-properties",
      [
        "expo-camera",
        {
          "cameraPermission": "Munim needs the camera to scan invoices."
        }
      ],
      [
        "expo-location",
        {
          "locationPermission": "Munim tags each scan with a coarse location, used only to flag invoices scanned unusually far from where you normally scan."
        }
      ],
      [
        "llama.rn",
        {
          "enableEntitlements": true,
          "entitlementsProfile": "production",
          "forceCxx20": true,
          "enableOpenCLAndHexagon": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "182a85fb-0866-4194-88db-fcc8bb232d12"
      }
    },
    "owner": "abhi-dev99"
  }
}
